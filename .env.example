# Semantic Memory Buffer — configuration (copy to .env)
# By default embeddings run locally (nomic-embed-text-v1.5); no key needed.

# Optional: Gemini API key. When set, embeddings use gemini-embedding-001
# (falls back to local Nomic on network/key errors).
# Get a key at https://aistudio.google.com/apikey (free tier works).
SM_GEMINI_API_KEY=

# Path prefix for the buffer (<db>.index FAISS index + <db>.jsonl metadata
# + <db>.clock + <db>.decay.json adaptive-decay state)
SM_BUFFER_DB=./memory_buffer.db

# Default exponential-decay lambda for R(q, v_i) = cos * exp(-lambda * age)
SM_DEFAULT_DECAY_LAMBDA=0.05

# Gemini embedding model + output dimensionality (768/1536/3072 for embedding-001)
# Only used when SM_GEMINI_API_KEY is set.
SM_EMBED_MODEL=gemini-embedding-001
SM_EMBED_DIM=768

# Advanced: endpoint override and request timeout (seconds)
SM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
SM_REQUEST_TIMEOUT=30
